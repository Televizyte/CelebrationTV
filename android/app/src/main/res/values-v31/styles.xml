<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/celebration_royal_blue</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/celebration_royal_blue</item>
        <item name="android:postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:statusBarColor">@color/celebration_royal_blue</item>
        <item name="android:navigationBarColor">@color/celebration_royal_blue</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/normal_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/celebration_royal_blue</item>
        <item name="android:navigationBarColor">@color/celebration_royal_blue</item>
    </style>
</resources>
